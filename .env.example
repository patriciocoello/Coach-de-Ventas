# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Sólo servidor. Nunca la expongas en el frontend.
SUPABASE_SERVICE_ROLE_KEY=

# --- IA ---
# gemini (gratis con límites) | mock (demo sin IA)
AI_PROVIDER=gemini
# Key gratuita: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opcional: también se pueden elegir desde Admin → Resumen
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EVAL_MODEL=gemini-2.5-flash
